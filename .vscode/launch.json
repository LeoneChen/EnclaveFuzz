{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "clang++",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/llvm-project/bin/clang++",
            "args": [
                "-m64",
                "-O0",
                "-g",
                "-Wall",
                "-Wextra",
                "-Winit-self",
                "-Wpointer-arith",
                "-Wreturn-type",
                "-Waddress",
                "-Wsequence-point",
                "-Wformat-security",
                "-Wmissing-include-dirs",
                "-Wfloat-equal",
                "-Wundef",
                "-Wshadow",
                "-Wcast-align",
                "-Wcast-qual",
                "-Wconversion",
                "-Wredundant-decls",
                "-Wnon-virtual-dtor",
                "-std=c++11",
                "-IInclude",
                "-IEnclave",
                "-I/home/leone/EnclaveFuzz/install/enclave_fuzz/include",
                "-I/home/leone/EnclaveFuzz/install/enclave_fuzz/include/tlibc",
                "-I/home/leone/EnclaveFuzz/install/enclave_fuzz/include/libcxx",
                "-nostdinc",
                "-fvisibility=hidden",
                "-fpie",
                "-ffunction-sections",
                "-fdata-sections",
                "-B/usr/local/bin",
                "-fstack-protector",
                "-nostdinc++",
                "-fsanitize=address",
                "-mllvm",
                "-asan-enclave",
                "-mllvm",
                "-asan-use-after-return=never",
                "-fsanitize-coverage=inline-8bit-counters,pc-table",
                "-S",
                "-emit-llvm",
                "Enclave/TrustedLibrary/StringHookTests.cpp",
                "-o",
                "Enclave/TrustedLibrary/StringHookTests.ll"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/sgx_apps/SampleSGXSan",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "sgxwallet",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sgx_apps/sgxwallet/poc_bls_sign_oracle",
            "args": [
                "-V",
                "-y",
                "-n"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/sgx_apps/sgxwallet/",
            "environment": [],
            "externalConsole": false,
            // "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/gdb/sgx-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "mobilecoin",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sgx_apps/mobilecoin/target/debug/fuzz_ecall",
            "args": [
                "corpus/",
                "-max_len=4096"
            ],
            "miDebuggerPath": "/home/leone/EnclaveFuzz/gdb/sgx-gdb",
            "cwd": "${workspaceFolder}/sgx_apps/mobilecoin",
            "environment": [
                {
                    "name": "ENCLAVE_PATH",
                    "value": "/home/leone/EnclaveFuzz/sgx_apps/mobilecoin/target/debug/libconsensus-enclave.signed.so"
                }
            ],
            "setupCommands": [
                {
                    "description": "Load Rust pretty-printers",
                    "text": "python import sys; sys.path.insert(0, '/usr/share/gdb/python'); from rust_gdb import register_printers; register_printers(gdb)",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-gdb-set substitute-path /home/sgx/jenkins/workspace/SDK_DCAP_build_release/main_repo/modules/linux-sgx/ /home/leone/confidential-computing.sgx",
                }
            ]
        },
        {
            "name": "Attach TestApp",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/workdir/sgxwallet/TestApp",
            "miDebuggerPath": "${workspaceFolder}/gdb/sgx-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "TestApp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/workdir/wasm-micro-runtime/TestApp",
            "args": [
                "./result/seeds",
                "-artifact_prefix=./result/crashes/",
                // "./result/seeds/001e6151b42a01614d5b13ce4f4541a53d9c312e",
                "-report_slow_units=60",
                // "-rss_limit_mb=10240",
                // "-max_len=65536",
                // "-print_coverage=1",
                // "-runs=0"
                // "-fork=1",
                // "-ignore_crashes=1",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/workdir/wasm-micro-runtime",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/home/leone/EnclaveFuzz/install/enclave_fuzz_n/lib64"
                }
            ],
            "externalConsole": false,
            "miDebuggerPath": "${workspaceFolder}/gdb/sgx-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
    ]
}