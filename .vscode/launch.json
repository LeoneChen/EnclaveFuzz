    "version": "0.2.0",
    "configurations": [
        {
            "name": "TestApp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/workdir/sgx-wallet/TestApp",
            "args": [
                "./result/seeds",
                "-artifact_prefix=./result/crashes/",
                // "./result/crashes/crash-10df032c2d6e79b8241d80e4faa0b50cef1a08d3",
                // "-runs=0"
                // "-fork=1",
                // "-ignore_crashes=1",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/workdir/sgx-wallet",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/home/leone/EnclaveFuzz1/install/enclave_fuzz/lib64"
                }
            ],
            "externalConsole": false,
            // "MIMode": "gdb",
            "miDebuggerPath": "/opt/intel/sgxsdk/bin/sgx-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "text": "-gdb-set substitute-path /build/glibc-B3wQXB/glibc-2.31/ /home/leone/glibc-2.31",
                },
                {
                    "text": "-gdb-set substitute-path /home/leone/EnclaveFuzz1/third_party/linux-sgx/sdk/simulation/urtssim/linux/enter_enclave.S /home/leone/EnclaveFuzz1/third_party/linux-sgx/psw/urts/linux/enter_enclave.S",
                }
            ]
        },
    ]
}